# HuggingFace configuration
# HF_TOKEN: Your HuggingFace API token (from hf.co/settings/tokens)
# HF_ENDPOINT_URL: Your dedicated Inference Endpoint URL (created at ui.endpoints.huggingface.co)
# Leave HF_ENDPOINT_URL blank until the endpoint is provisioned (Phase 2).
HF_TOKEN=your_hf_token_here
HF_ENDPOINT_URL=
MODEL_ID=meta-llama/Meta-Llama-3.1-8B-Instruct

# Experiment configuration
GLOBAL_SEED=42
LOG_LEVEL=INFO
