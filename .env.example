# ─── Inference Providers ──────────────────────────────────────────────────────

# PRIMARY: DeepInfra (FP8 quantisation — used for all Phase 16 experiments)
# Get API key at: deepinfra.com/dash/api_keys
DEEPINFRA_API_KEY=your_deepinfra_key_here
DEEPINFRA_MODEL_ID=meta-llama/Meta-Llama-3.1-8B-Instruct
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai

# LEGACY: SambaNova Cloud (full BF16/FP32 — Phase 10-15 experiments)
# Service deprecated Meta-Llama-3.1-8B-Instruct on 2026-04-14
SAMBANOVA_API_KEY=your_sambanova_key_here
SAMBANOVA_MODEL_ID=Meta-Llama-3.1-8B-Instruct
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1

# JUDGE: Groq (llama-3.3-70b-versatile — RAGAS faithfulness evaluation only)
# Get API key at: console.groq.com
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL_ID=llama-3.1-8b-instant
GROQ_JUDGE_MODEL_ID=llama-3.3-70b-versatile

# Active provider for this session
INFERENCE_PROVIDER=deepinfra

# ─── Experiment Configuration ────────────────────────────────────────────────
GLOBAL_SEED=42
LOG_LEVEL=INFO
