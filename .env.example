# ─── Inference Providers ──────────────────────────────────────────────────────

# PRIMARY: SambaNova Cloud (full BF16/FP32 precision — used for all experiments)
# Get API key at: cloud.sambanova.ai
SAMBANOVA_API_KEY=your_sambanova_key_here
SAMBANOVA_MODEL_ID=Meta-Llama-3.1-8B-Instruct
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1

# DEVELOPMENT BACKUP: Groq (TruePoint quantised — used for smoke tests only)
# Get API key at: console.groq.com
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL_ID=llama-3.1-8b-instant

# Active provider for this session ("sambanova" for experiments, "groq" for dev)
INFERENCE_PROVIDER=sambanova

# ─── Experiment Configuration ────────────────────────────────────────────────
GLOBAL_SEED=42
LOG_LEVEL=INFO
